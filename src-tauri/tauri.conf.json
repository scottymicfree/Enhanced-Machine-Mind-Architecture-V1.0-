{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "emma-dashboard",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": false,
        "execute": true,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.emma.sovereign.dashboard",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png"
      ]
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:5173 http://localhost:8080 http://localhost:11434 ws://localhost:8124 ws://127.0.0.1:8124; img-src 'self' data:; style-src 'self' 'unsafe-inline';"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "E.M.M.A. Command Dashboard v1.0.0-PROD",
        "width": 1440
      }
    ]
  }
}
